{
  "name": "replicate",
  "title": "Replicate",
  "description": "Replicate is a tool for creating and sharing machine learning models. This extension allows you to create and view your predictions in Raycast.",
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "icon": "replicate.png",
  "author": "KevinBatdorf",
  "contributors": [
    "bfirsh",
    "charlieholtz"
  ],
  "categories": [
    "Media",
    "Design Tools",
    "Productivity"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "replicate",
      "title": "Replicate",
      "subtitle": "Run models in the cloud",
      "description": "Run models in the cloud",
      "mode": "view"
    }
  ],
  "tools": [
    {
      "name": "generate-image",
      "title": "Generate Image",
      "description": "Generate an image from a text prompt by running a model on Replicate, and save a copy of the result locally."
    }
  ],
  "ai": {
    "instructions": "Show every generated image by repeating the `markdown` field from the generate-image result verbatim in your reply; an image the user cannot see counts as a failed generation. Keep the `images[].file` paths out of the reply unless the user asks where the file went. Only pass `model` when the user names one, and never invent a model name \u2014 Replicate models are written as owner/name.",
    "evals": [
      {
        "input": "@replicate generate an image of a cat riding a bicycle through Tokyo at night",
        "mocks": {
          "generate-image": {
            "model": "black-forest-labs/flux-schnell",
            "prompt": "a cat riding a bicycle through Tokyo at night",
            "predictionUrl": "https://replicate.com/p/abc123",
            "images": [
              {
                "url": "https://replicate.delivery/abc123/out-0.webp",
                "file": "/tmp/abc123-0.webp"
              }
            ],
            "markdown": "![a cat riding a bicycle through Tokyo at night](https://replicate.delivery/abc123/out-0.webp)"
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "generate-image",
              "arguments": {
                "prompt": {
                  "includes": "cat"
                }
              }
            }
          },
          {
            "includes": "https://replicate.delivery/abc123/out-0.webp"
          }
        ]
      },
      {
        "input": "@replicate make me a 16:9 desktop wallpaper of a foggy pine forest",
        "mocks": {
          "generate-image": {
            "model": "black-forest-labs/flux-schnell",
            "prompt": "a foggy pine forest",
            "predictionUrl": "https://replicate.com/p/def456",
            "images": [
              {
                "url": "https://replicate.delivery/def456/out-0.webp",
                "file": "/tmp/def456-0.webp"
              }
            ],
            "markdown": "![a foggy pine forest](https://replicate.delivery/def456/out-0.webp)"
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "generate-image",
              "arguments": {
                "aspectRatio": "16:9"
              }
            }
          }
        ]
      },
      {
        "input": "@replicate generate a watercolour fox with google/nano-banana",
        "mocks": {
          "generate-image": {
            "model": "google/nano-banana",
            "prompt": "a watercolour fox",
            "predictionUrl": "https://replicate.com/p/ghi789",
            "images": [
              {
                "url": "https://replicate.delivery/ghi789/out-0.png",
                "file": "/tmp/ghi789-0.png"
              }
            ],
            "markdown": "![a watercolour fox](https://replicate.delivery/ghi789/out-0.png)"
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "generate-image",
              "arguments": {
                "model": "google/nano-banana"
              }
            }
          }
        ]
      }
    ]
  },
  "preferences": [
    {
      "name": "token",
      "type": "password",
      "title": "API Token",
      "description": "Add your token from Replicate",
      "placeholder": "Token",
      "required": true
    },
    {
      "name": "defaultModel",
      "type": "textfield",
      "title": "Default Model",
      "description": "The model the AI tool runs when the prompt doesn't name one, written as owner/name.",
      "default": "black-forest-labs/flux-schnell",
      "required": false
    },
    {
      "name": "confirmGenerations",
      "type": "checkbox",
      "title": "AI Tool",
      "label": "Confirm before generating",
      "description": "Ask for confirmation before the AI tool runs a model and bills your Replicate account.",
      "default": true,
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.25",
    "@raycast/utils": "^2.3.0",
    "is-image": "^3.1.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
